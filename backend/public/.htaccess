<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Vite puts a content hash in every file below build/assets.  When the
    # domain points directly at this public directory (or exposes that folder
    # through a verified symlink), the web server can serve those files
    # without booting PHP and safely retain them across releases.
    RewriteRule ^build/assets/ - [E=ALMUNJAZ_IMMUTABLE_BUILD:1]
    RewriteRule ^assets/ - [E=ALMUNJAZ_PUBLIC_ASSET:1]

    <IfModule mod_headers.c>
        Header always set Cache-Control "public, max-age=31536000, immutable" env=ALMUNJAZ_IMMUTABLE_BUILD
        Header always set X-Content-Type-Options "nosniff" env=ALMUNJAZ_IMMUTABLE_BUILD
        Header always set Cache-Control "public, max-age=3600" env=ALMUNJAZ_PUBLIC_ASSET

        # Older installed copies registered /sw.js and /manifest.json. These
        # control files must never inherit the host's long-lived JS/JSON cache
        # policy, otherwise a PWA can remain on a stale interface for weeks.
        <FilesMatch "^(sw\.js|manifest\.json)$">
            Header always unset Expires
            Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Header always set Pragma "no-cache"
        </FilesMatch>
    </IfModule>

    # Text responses and Inertia JSON are sent on every screen change. Enable
    # compression where the hosting server supports it; Apache/LiteSpeed
    # simply skip this block when their compression module is unavailable.
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
    </IfModule>

    # Keep one canonical origin for each installed PWA. The reverse proxy
    # forwards HTTPS as X-Forwarded-Proto, so both checks are required.
    RewriteCond %{HTTP_HOST} ^www\.mobile\.our-qiq\.com$ [NC]
    RewriteRule ^ https://mobile.our-qiq.com%{REQUEST_URI} [R=302,L]

    RewriteCond %{HTTP_HOST} ^www\.admin\.our-qiq\.com$ [NC]
    RewriteRule ^ https://admin.our-qiq.com%{REQUEST_URI} [R=302,L]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

    # The two legacy PWA URLs must always reach Laravel. Older installed
    # copies registered /sw.js and /manifest.json; routing them to the same
    # versioned response migrates those installations instead of leaving them
    # on an obsolete cache.
    RewriteRule ^(?:pwa/manifest|pwa/worker|manifest\.json|sw\.js)$ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
