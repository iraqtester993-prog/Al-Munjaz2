APP_NAME="المنجز - تجريبي"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.our-qiq.com

# قاعدة مستقلة تماماً عن الإنتاج؛ تُملأ من نسخة احتياطية دورية فقط.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ourqiq_almunjaz_staging
DB_USERNAME=ourqiq_stage
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
SANCTUM_STATEFUL_DOMAINS=staging-app.our-qiq.com,staging-dashboard.our-qiq.com

# يمنع الرسائل الحقيقية والخدمات الخارجية في التجريبي.
STAGING=true
