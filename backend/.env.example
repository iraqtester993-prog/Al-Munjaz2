APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PRODUCT_DOMAIN=our-qiq.test
PRODUCT_MOBILE_HOST=mobile.our-qiq.test
PRODUCT_ADMIN_HOST=admin.our-qiq.test
PWA_VERSION=v17

# Temporary OTP bridge. Replace this with an SMS provider before public launch.
TEMPORARY_OTP_CODE=123456
TEMPORARY_OTP_TTL_SECONDS=600
TEMPORARY_OTP_MAX_ATTEMPTS=5
TEMPORARY_OTP_RESEND_COOLDOWN_SECONDS=60
TEMPORARY_OTP_SHOW_CODE_HINT=true

# Generate one VAPID key pair on the server and keep the private key secret.
VAPID_SUBJECT=https://our-qiq.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Courier registration sends five documents in one request. Browser-side image
# preparation and Laravel use these matching limits to avoid a hosting 413.
COURIER_DOCUMENT_MAX_KB=480
COURIER_DOCUMENT_TOTAL_MAX_KB=1600
COURIER_DOCUMENT_TARGET_IMAGE_KB=300

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=almunjaz_session_v13
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
