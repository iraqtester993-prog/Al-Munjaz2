APP_NAME="المنجز السريع"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mobile.our-qiq.com
PRODUCT_DOMAIN=our-qiq.com
PRODUCT_MOBILE_HOST=mobile.our-qiq.com
PRODUCT_ADMIN_HOST=admin.our-qiq.com
PWA_VERSION=v15

# Generate one VAPID key pair on the production server. Never commit the private key.
VAPID_SUBJECT=https://our-qiq.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Courier registration document limits. Keep the total below the hosting proxy
# request limit; the browser optimizes images to the target value first.
COURIER_DOCUMENT_MAX_KB=1024
COURIER_DOCUMENT_TOTAL_MAX_KB=4096
COURIER_DOCUMENT_TARGET_IMAGE_KB=700

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_strong_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=almunjaz_session_v13
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
